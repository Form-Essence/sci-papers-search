{
  "_comment": "Copy to mcp-config.json and adjust. One Python process serves UI + /api/* + /mcp on server.{host,port}. The /mcp endpoint is open — no authentication required.",
  "_ui_password_hint": "Non-empty ui_password enables the web UI login screen (server-side only). Leave \"\" to disable.",
  "ui_password": "",
  "session_secret": "",
  "public_url": "https://papers.fes-lab.work",

  "server": {
    "host": "0.0.0.0",
    "port": 3636,
    "cors_origins": ["*"],
    "per_source_timeout": 25,
    "api_keys": {
      "unpaywall_email": "",
      "core_api_key": "",
      "semantic_scholar_api_key": "",
      "google_scholar_proxy_url": "",
      "zenodo_access_token": "",
      "doaj_api_key": "",
      "ieee_api_key": "",
      "acm_api_key": ""
    }
  },

  "clients": {
    "cursor_mcp_json": {
      "mcpServers": {
        "paper-search": {
          "url": "http://localhost:3636/mcp"
        }
      }
    },
    "lm_studio_mcp_json": {
      "mcpServers": {
        "paper-search": {
          "url": "http://localhost:3636/mcp"
        }
      }
    },
    "opencode_config": {
      "mcp": {
        "paper-search": {
          "type": "remote",
          "url": "http://localhost:3636/mcp",
          "enabled": true
        }
      }
    },
    "openai_responses_api_snippet": {
      "tools": [
        {
          "type": "mcp",
          "server_label": "paper-search",
          "server_url": "http://localhost:3636/mcp",
          "require_approval": "never"
        }
      ]
    },
    "curl_smoke_test": "curl -N -X POST 'http://localhost:3636/mcp' -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}'"
  }
}
