{
  "_comment": "Single source of truth. Copy to mcp-config.json, then run ./scripts/gen-token.sh to seed auth_token and regenerate client snippets. One Python process serves UI + /api/* + /mcp on server.{host,port}.",
  "auth_token": "",
  "public_url": "http://localhost:3636",

  "server": {
    "host": "0.0.0.0",
    "port": 3636,
    "cors_origins": ["*"],
    "api_keys": {
      "unpaywall_email": "",
      "core_api_key": "",
      "semantic_scholar_api_key": "",
      "google_scholar_proxy_url": "",
      "zenodo_access_token": "",
      "doaj_api_key": "",
      "ieee_api_key": "",
      "acm_api_key": ""
    }
  },

  "clients": {
    "cursor_mcp_json": {
      "mcpServers": {
        "paper-search": {
          "url": "http://localhost:3636/mcp",
          "headers": { "Authorization": "Bearer <TOKEN>" }
        }
      }
    },
    "lm_studio_mcp_json": {
      "mcpServers": {
        "paper-search": {
          "url": "http://localhost:3636/mcp",
          "headers": { "Authorization": "Bearer <TOKEN>" }
        }
      }
    },
    "opencode_config": {
      "mcp": {
        "paper-search": {
          "type": "remote",
          "url": "http://localhost:3636/mcp",
          "headers": { "Authorization": "Bearer <TOKEN>" },
          "enabled": true
        }
      }
    },
    "openai_responses_api_snippet": {
      "tools": [
        {
          "type": "mcp",
          "server_label": "paper-search",
          "server_url": "http://localhost:3636/mcp",
          "headers": { "Authorization": "Bearer <TOKEN>" },
          "require_approval": "never"
        }
      ]
    },
    "curl_smoke_test": "curl -N -X POST 'http://localhost:3636/mcp' -H 'Authorization: Bearer <TOKEN>' -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}'"
  }
}
